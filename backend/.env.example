# Main database (Neon "direct" connection string, or any PostgreSQL 14+)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Separate database/branch used ONLY by `npm test` (it is wiped on every run!)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb_test?sslmode=require

PORT=3000

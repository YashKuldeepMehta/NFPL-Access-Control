{
  "name": "nfpl-access-backend",
  "version": "1.0.0",
  "description": "Access Control Service for NFPL (Nagarkot take-home): who may do what on which job",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node seed/seed.js",
    "seed:scale": "node seed/scale.js",
    "readme:access": "node seed/print-access.js",
    "bootstrap-admin": "node seed/bootstrap-admin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
